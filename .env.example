# ===== jins-forum (второй хостинг): только форум =====
# Обязательные — ТЕ ЖЕ значения, что у jins-bot
BOT_TOKEN=123456:replace_with_bot_token
DATABASE_URL=postgresql://user:pass@host:5432/dbname      # ОБЩАЯ БД (внешний адрес, доступный с этого хостинга)
OWNER_ID=123456789

# Публичный адрес ФОРУМА (этого сервиса), https. Нужен для кнопок «Открыть» в пушах бота,
# для скачивания APK (/forum/app.html?dl=1) и для будилки.
FORUM_URL=https://your-forum.example.com

# Адрес мини-аппа (сервис jins-bot на Render) — для кнопок «Открыть чат» в пушах о личных сообщениях
WEBAPP_URL=https://your-bot.onrender.com

# Необязательно
# PORT=10000                 # большинство хостингов задаёт сам
# FORUM_KEEPALIVE=1          # 0 — выключить будилку (пинг FORUM_URL/health раз в 10 минут)
# GEMINI_API_KEY=            # ИИ «Поддержки» в чатах форума (то же, что у бота)
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
# TZ_NAME=Europe/Moscow
